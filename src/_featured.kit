<section class="featured-section">
    <div class="container">
        <header class="section-header">
            <h2>Featured Pieces</h2>
            <p>Highlights from our collection</p>
        </header>

        <div class="product-grid">
            <!-- Produto 1 -->
            <article class="product-card">
                <!-- Trocámos a div por figure -->
                <figure class="product-image">
                    <img src="src/assets/img/lamp.png" alt="Tiffany Table Lamp">
                    <figcaption class="badge">Late 19th Century</figcaption>
                </figure>
                <div class="product-info">
                    <h3>Tiffany Table Lamp</h3>
                    <p class="price">€2,400</p>
                </div>
            </article>

            <!-- Produto 2 -->
            <article class="product-card">
                <figure class="product-image">
                    <img src="src/assets/img/chair.png" alt="Georgian Armchair">
                    <figcaption class="badge">18th Century</figcaption>
                </figure>
                <div class="product-info">
                    <h3>Georgian Armchair</h3>
                    <p class="price">€3,200</p>
                </div>
            </article>

            <!-- Produto 3 -->
            <article class="product-card">
                <figure class="product-image">
                    <img src="src/assets/img/vanity.png" alt="Dressing Table">
                    <figcaption class="badge">19th Century</figcaption>
                </figure>
                <div class="product-info">
                    <h3>Dressing Table</h3>
                    <p class="price">€4,800</p>
                </div>
            </article>

            <!-- Produto 4 -->
            <article class="product-card">
                <figure class="product-image">
                    <img src="src/assets/img/portrait.png" alt="Classical Portrait">
                    <figcaption class="badge">18th Century</figcaption>
                </figure>
                <div class="product-info">
                    <h3>Classical Portrait</h3>
                    <p class="price">€5,900</p>
                </div>
            </article>
        </div>
    </div>
</section>