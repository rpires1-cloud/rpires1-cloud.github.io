<!-- @import "head" -->
<body>

  <!-- @import "header" -->

 <main>
  <section class="product-page-info">
    <div class="product-page-grid">
      <!-- LEFT -->
      <div>
        <figure class="product-page-image"><img src="src/assets/img/product_8/chandelier-1.png" alt="Cristal Chandelier view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_8/chandelier-2.png" alt="Cristal Chandelier view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_8/chandelier-3.png" alt="Cristal Chandelier view 2"></figure>
            </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div>
        <h1 class="product-title">Crystal Chandelier </h1>
        <p class="product-subtitle">Italian Baroque</p>
        <p class="price">€5,800</p>
        <div class="details-box">
          <div class="product-detail-item">
            <!-- @import assets/svg/calendar-product.svg -->
            <div>
              <p class="detail-label">Auction Date</p>
              <p class="detail-value">15 July 2026</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/lot-number-product.svg -->
            <div>
              <p class="detail-label">Lot Number</p>
              <p class="detail-value">Lot 17</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/category-product.svg -->
            <div>
              <p class="detail-label">Category</p>
              <p class="detail-value">Furniture</p>
            </div>
          </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="content-section container">
    <div class="content-grid">
    <!-- LEFT CONTENT -->
      <div>
        <div class="content-block">
          <h2>Description</h2>
          <p>This magnificent 18th-century crystal chandelier is a masterwork of light and glass. With multi-tiered arms adorned with cascading crystal drops, it creates a dazzling atmospheric effect, transforming any room into an opulent space of classic grandeur.T</p>
        </div>

        <div class="content-block">
          <h2>History & Provenance</h2>
          <h3>Historical Context</h3>
          <p>Created when candlelight was the primary source of illumination, chandeliers were designed to maximize reflection through meticulously cut glass crystals. They were the ultimate expression of luxury in the grand halls of European nobility.</p>
          <h3>Provenance</h3>
          <p>Chateau inventory, Loire Valley, 1750-1900; <br>Restored by master glassmakers, 1960;<br> Private collection, Geneva, 1980-present.</p>
        </div>
      </div>

      <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 128 cm</p>
            <p>Width: 72 cm</p>
            <p>Depth: 68 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Walnut</p>
            <p>Genoese velvet</p>
            <p>Gilt accents</p>
          </div>
          
          <div class="spec-group">
            <h4>Period</h4>
            <p>Italian Baroque</p>
          </div>
        </aside>
      </div>
  </section>

      <!-- NOTES -->
  <section>
    <div class="notes-grid">
      <div class="note-card">
        <h3>Condition Notes</h3>
        <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and techniques.</p>
        <ul class="notes-list">
          <li>Minor losses to carved details on rear legs</li>
          <li>Historic repair to arm joint (stable and well-executed)</li>
          <li>Some darkening of wood finish on seat rails</li>
          <li>Natural age cracks in wood (stable)</li>
        </ul>
      </div>

      <div class="note-card bid-card">
        <div>
          <h3>Bidding Information</h3>
          <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
        </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->
</body>
</html>