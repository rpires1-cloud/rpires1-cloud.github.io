<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Héritage | Our Auctions</title>
    <link rel="stylesheet" href="/assets/css/style.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300&family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
  </head>
<body>

  <!-- @import "header" -->

<main>
  <section class="banner">
            <figure class="hero-banner">
                <img src="src/assets/img/auctions-hero.png" alt="Interior Clássico Héritage" class="hero-img">
            </figure>
            <div class="hero-title">
                <h1>Our <span class="page-title">Auctions</span></h1>
                <p>Participate in the legacy of timeless craftsmanship</p>
            </div>
        </section>

  <!-- @import "upcoming-auctions" -->

  <!-- RECORD SALES -->
  <section class="sales-section">
    <div class="container">
      <div class="section-heading">
        <h2>Recent Record Sales</h2>
        <p>Top bids from our past auctions</p>
      </div>

      <div class="sales-grid">
        <div class="sale-card">
          <figure><img src="src/assets/img/Baroque-Clock.png" alt="Imperial clock"></figure>
          <div class="sale-content">
            <p>18th Century</p>
            <h3>Imperial Baroque Clock</h3>
            <div class="sale-footer">
              <p>€12,400</p>
              <p>March 2026</p>
            </div>
          </div>
        </div>

        <div class="sale-card">
          <figure><img src="src/assets/img/Gilded-Mirror.png" alt="Victorian mirror"></figure>
          <div class="sale-content">
            <p>19th Century</p>
            <h3>Victorian Gilded Mirror</h3>
            <div class="sale-footer">
              <p>€9,800</p>
              <p>February 2026</p>
            </div>
          </div>
        </div>

        <div class="sale-card">
          <figure><img src="src/assets/img/Crystal-Chandelier.png" alt="Crystal chandelier"></figure>
            <div class="sale-content">
              <p>Art Nouveau</p>
              <h3>Crystal Chandelier</h3>
              <div class="sale-footer">
                <p>€15,200</p>
                <p>January 2026</p>
              </div>
            </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTICIPATE -->
  <section class="participation-container">
    <div class="participate-header">
      <h2>How to <span class="page-title">Participate</span></h2>
      <p>Important guidelines and rules for bidding at HÉRITAGE auctions</p>
    </div>

    <div class="participate-grid">
      <div class="participate-card">
        <div class="icon-text">
          <!-- @import assets/svg/registration.svg -->
          <h3>Registration</h3>
        </div>
        <p>All bidders must register at least 48 hours before the auction. Valid identification and proof of funds may be required.</p>
      </div>

      <div class="participate-card">
        <div class="icon-text">
          <!-- @import assets/svg/buyer.svg -->
          <h3>Buyer’s Premium</h3>
        </div>
        <p>A buyer’s premium of 25% is added to the hammer price. This includes insurance and handling.</p>
      </div>

      <div class="participate-card">
        <div class="icon-text">
          <!-- @import assets/svg/payment.svg -->
          <h3>Payment Terms</h3>
        </div>
        <p>Payment is due within 7 business days of the auction. We accept bank transfers and major cards.</p>
      </div>

      <div class="participate-card">
        <div class="icon-text">
          <!-- @import assets/svg/bidding.svg -->
          <h3>Bidding Increments</h3>
        </div>
        <p>Bidding increments vary by lot value. Typically €100 for lots under €5,000 and higher for premium lots.</p>
      </div>

      <div class="participate-card">
        <div class="icon-text">
          <!-- @import assets/svg/absentee.svg -->
          <h3>Absentee</h3>
        </div>
        <p>Cannot attend in person? Submit absentee bids or arrange phone bidding by contacting us in advance.</p>
      </div>

      <div class="participate-card">
        <div class="icon-text">
          <!-- @import assets/svg/schedule.svg -->
          <h3>Viewing Schedule</h3>
        </div>
        <p>All lots are available for viewing 3 days prior to auction during business hours.</p>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->

</body>
</html>