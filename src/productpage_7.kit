<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>Héritage | Pedestal Table</title>
  <link rel="stylesheet" href="/assets/css/style.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300&family=Playfair+Display:ital,wght@1,400&display=swap"
    rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
</head>

<body>

  <!-- @import "header" -->

  <main>
    <section class="product-page-info">
      <div class="product-page-grid">
        <!-- LEFT -->
        <div>
          <figure class="product-page-image"><img src="src/assets/img/product_7/pedestal-table-2.png" id="selected"
              alt="Pedestal Table view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_7/pedestal-table-2.png" class="product active"
                  alt="Pedestal Table view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_7/pedestal-table-3.png" class="product"
                  alt="Pedestal Table view 2"></figure>
            </div>
          </div>
        </div>

        <!-- RIGHT -->
        <div>
          <h1 class="product-title">Pedestal Table</h1>
          <p class="product-subtitle">Italian Baroque</p>
          <p class="price">€1,200</p>
          <div class="details-box">
            <div class="product-detail-item">
              <!-- @import assets/svg/calendar-product.svg -->
              <div>
                <p class="detail-label">Auction Date</p>
                <p class="detail-value">15 July 2026</p>
              </div>
            </div>

            <div class="product-detail-item">
              <!-- @import assets/svg/lot-number-product.svg -->
              <div>
                <p class="detail-label">Lot Number</p>
                <p class="detail-value">Lot 17</p>
              </div>
            </div>

            <div class="product-detail-item">
              <!-- @import assets/svg/category-product.svg -->
              <div>
                <p class="detail-label">Category</p>
                <p class="detail-value">Furniture</p>
              </div>
            </div>
          </div>
    </section>

    <!-- CONTENT -->
    <section class="content-section container">
      <div class="content-grid">
        <!-- LEFT CONTENT -->
        <div>
          <div class="content-block">
            <h2>Description</h2>
            <p>A hallmark of 18th-century craftsmanship, this elegant pedestal table features a balanced circular top
              supported by a gracefully turned central column. Its minimalist design highlights the natural beauty of
              the wood, making it a versatile and sophisticated addition to any refined interior.</p>
          </div>

          <div class="content-block">
            <h2>History & Provenance</h2>
            <h3>Historical Context</h3>
            <p>Pedestal tables rose to prominence in the 1700s as symbols of Enlightenment-era focus on proportion and
              function. This design was favored for its ability to save space while serving as a focal point for
              intimate gatherings.</p>
            <h3>Provenance</h3>
            <p>Private estate, England, 1790-1880;<br> Auctioned in London, 1920; <br>Private collection, Paris,
              1950-present.</p>
          </div>
        </div>

        <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 75 cm</p>
            <p>Diamenter:: 90 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Mahogany</p>
            <p>Veneer</p>
          </div>

          <div class="spec-group">
            <h4>Period</h4>
            <p>18th Century</p>
          </div>
        </aside>
      </div>
    </section>

    <!-- NOTES -->
    <section>
      <div class="notes-grid">
        <div class="note-card">
          <h3>Condition Notes</h3>
          <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and
            techniques.</p>
          <ul class="notes-list">
            <li>Minor losses to carved details on rear legs</li>
            <li>Historic repair to arm joint (stable and well-executed)</li>
            <li>Some darkening of wood finish on seat rails</li>
            <li>Natural age cracks in wood (stable)</li>
          </ul>
        </div>

        <div class="note-card bid-card">
          <div>
            <h3>Bidding Information</h3>
            <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
          </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
        </div>
      </div>
    </section>
  </main>

  <!-- @import "footer" -->
  <script src="src/assets/js/script.js"></script>

</body>

</html>