<!-- @import "head" -->
<body>

  <!-- @import "header" -->

 <main>
  <section class="product-page-info">
    <div class="product-page-grid">
      <!-- LEFT -->
      <div>
        <figure class="product-page-image"><img src="src/assets/img/product_2/table-lamp-1.png" alt="Tiffany Table Lamp view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_2/table-lamp-2.png" alt="Tiffany Table Lamp view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_2/table-lamp-3.png" alt="Tiffany Table Lamp view 2"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_2/table-lamp-4.png" alt="Tiffany Table Lamp view 3"></figure>
            </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div>
        <h1 class="product-title">Tiffany Table Lamp</h1>
        <p class="product-subtitle">Art Nouveau</p>
        <p class="price">€2,400</p>
        <div class="details-box">
          <div class="product-detail-item">
            <!-- @import assets/svg/calendar-product.svg -->
            <div>
              <p class="detail-label">Auction Date</p>
              <p class="detail-value">30 May 2026</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/lot-number-product.svg -->
            <div>
              <p class="detail-label">Lot Number</p>
              <p class="detail-value">Lot 11</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/category-product.svg -->
            <div>
              <p class="detail-label">Category</p>
              <p class="detail-value">Furniture</p>
            </div>
          </div>

    </div>
  </section>

  <!-- CONTENT -->
  <section class="content-section container">
    <div class="content-grid">
    <!-- LEFT CONTENT -->
      <div>
        <div class="content-block">
          <h2>Description</h2>
          <p>This exquisite "Tiffany" table lamp exemplifies the elegance of the late 19th
century, combining intricate stained glass craftsmanship with an artistically detailed bronze base. The floral design, featuring soft pink tones and organic foliage, creates a warm and sophisticated atmosphere characteristic of the Art Nouveau aesthetic.</p>
        </div>

        <div class="content-block">
          <h2>History & Provenance</h2>
          <h3>Historical Context</h3>
          <p>Crafted during the height of the Art Nouveau movement, this piece reflects the transition from rigid Victorian styles to the fluid, nature-inspired designs of the late 1800s. It was designed to provide ambient lighting for the refined interiors of urban residences.</p>
          <h3>Provenance</h3>
          <p>Private collection, New York, 1920-1950; <br> by an art gallery in Paris, 1960; <br> Held in private European collection, 1985-present.</p>
        </div>
    </div>

      <!-- SPECIFICATIONS -->

        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 60 cm</p>
            <p>Width: 40 cm</p>
            <p>Depth: 20 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Stained glass</p>
            <p>Bronze</p>
          </div>
          
          <div class="spec-group">
            <h4>Period</h4>
            <p>19th Century</p>
          </div>
        </aside>
      </div>
  </section>

      <!-- NOTES -->
  <section>
    <div class="notes-grid">
      <div class="note-card">
        <h3>Condition Notes</h3>
        <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and techniques.</p>
        <ul class="notes-list">
          <li>Minor losses to carved details on rear legs</li>
          <li>Historic repair to arm joint (stable and well-executed)</li>
          <li>Some darkening of wood finish on seat rails</li>
          <li>Natural age cracks in wood (stable)</li>
        </ul>
      </div>

      <div class="note-card bid-card">
        <div>
          <h3>Bidding Information</h3>
          <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
        </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->
</body>
</html>