<!-- @import "head" -->
<body>

  <!-- @import "header" -->

 <main>
  <section class="product-info">
    <div class="product-page-grid">
      <!-- LEFT -->
      <div>
        <figure class="product-page-image"><img src="src/assets/img/product_5/wardrobe-1.png" alt="Wardrobe view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_5/wardrobe-2.png" alt="Wardrobe view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_5/wardrobe-3.png" alt="GWardrobe view 2"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_5/wardrobe-4.png" alt="Wardrobe view 3"></figure>
            </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div>
        <h1 class="product-title">Wardrobe</h1>
        <p class="product-subtitle">Art Nouveau</p>
        <p class="price">€3,200</p>
        <div class="details-box">
          <div class="product-detail-item">
            <!-- @import assets/svg/calendar-product.svg -->
            <div>
              <p class="detail-label">Auction Date</p>
              <p class="detail-value">30 May 2026</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/lot-number-product.svg -->
            <div>
              <p class="detail-label">Lot Number</p>
              <p class="detail-value">Lot 11</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/category-product.svg -->
            <div>
              <p class="detail-label">Category</p>
              <p class="detail-value">Furniture</p>
            </div>
          </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="content-section container">
    <div class="content-grid">
    <!-- LEFT CONTENT -->
      <div>
        <div class="content-block">
          <h2>Description</h2>
          <p>A rare find of exceptional quality, this antique armoire combines storage utility with a striking presence. Its rich wood grain, polished finish, and subtle ornate moldings make it a highly desirable piece for those seeking to blend functional storage with historical charm.</p>
        </div>

        <div class="content-block">
          <h2>History & Provenance</h2>
          <h3>Historical Context</h3>
          <p>Historically used for storing fine linens and formal attire, the armoire was a significant piece of furniture in bourgeois households. It represents the height of functional elegance from its era.</p>
          <h3>Provenance</h3>
          <p>Manor house inventory, Normandy, 1820; <br> dealer acquisition, Paris, 1930; <br>Private collection, London, 1970-present.</p>
        </div>
      </div>

      <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 1210 cm</p>
            <p>Width: 130 cm</p>
            <p>Depth: 60 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Oak</p>
            <p>Brass hardware</p>
          </div>
          
          <div class="spec-group">
            <h4>Period</h4>
            <p>19th Century</p>
          </div>
        </aside>
      </div>
  </section>

      <!-- NOTES -->
  <section>
    <div class="notes-grid">
      <div class="note-card">
        <h3>Condition Notes</h3>
        <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and techniques.</p>
        <ul class="notes-list">
          <li>Minor losses to carved details on rear legs</li>
          <li>Historic repair to arm joint (stable and well-executed)</li>
          <li>Some darkening of wood finish on seat rails</li>
          <li>Natural age cracks in wood (stable)</li>
        </ul>
      </div>

      <div class="note-card bid-card">
        <div>
          <h3>Bidding Information</h3>
          <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
        </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->
</body>
</html>