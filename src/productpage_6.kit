<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Héritage | Bed Frame</title>
    <link rel="stylesheet" href="/assets/css/style.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300&family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
  </head>
<body>

  <!-- @import "header" -->

 <main>
  <section class="product-page-info">
    <div class="product-page-grid">
      <!-- LEFT -->
      <div>
        <figure class="product-page-image"><img src="src/assets/img/product_6/bed-frame-1.png" alt="Bed Frame view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_6/bed-frame-2.png" alt="Bed Frame view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_6/bed-frame-3.png" alt="Bed Frame view 2"></figure>
            </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div>
        <h1 class="product-title">Bed Frame</h1>
        <p class="product-subtitle">Art Nouveau</p>
        <p class="price">€4,800</p>
        <div class="details-box">
          <div class="product-detail-item">
            <!-- @import assets/svg/calendar-product.svg -->
            <div>
              <p class="detail-label">Auction Date</p>
              <p class="detail-value">30 May 2026</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/lot-number-product.svg -->
            <div>
              <p class="detail-label">Lot Number</p>
              <p class="detail-value">Lot 11</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/category-product.svg -->
            <div>
              <p class="detail-label">Category</p>
              <p class="detail-value">Furniture</p>
            </div>
          </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="content-section container">
    <div class="content-grid">
    <!-- LEFT CONTENT -->
      <div>
        <div class="content-block">
          <h2>Description</h2>
          <p>This exquisite hand-carved bed frame serves as a testament to traditional artistry. Featuring intricate organic motifs and fluid, sculptural lines, the frame offers an aesthetic of timeless comfort and artisanal excellence, perfect for creating a sanctuary of classic luxury.</p>
        </div>

        <div class="content-block">
          <h2>History & Provenance</h2>
          <h3>Historical Context</h3>
          <p>Hand-carved beds of this caliber were historically commissioned as family heirlooms. The decorative carvings often reflected the specific motifs popular in regional cabinetmaking schools, emphasizing both structural integrity and aesthetic beauty.</p>
          <h3>Provenance</h3>
          <p>Master craftsman workshop, Northern Italy, 1850;<br> Private family collection, 1850-1990; <br>Acquired by current owner, 1995.</p>
        </div>
      </div>

      <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 210 cm</p>
            <p>Width: 165 cm</p>
            <p>Headboard Height: 140 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Walnut</p>
            <p>Genoese velvet</p>
            <p>Gilt accents</p>
          </div>
          
          <div class="spec-group">
            <h4>Period</h4>
            <p>19th Century</p>
          </div>
        </aside>
      </div>
  </section>

      <!-- NOTES -->
  <section>
    <div class="notes-grid">
      <div class="note-card">
        <h3>Condition Notes</h3>
        <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and techniques.</p>
        <ul class="notes-list">
          <li>Minor losses to carved details on rear legs</li>
          <li>Historic repair to arm joint (stable and well-executed)</li>
          <li>Some darkening of wood finish on seat rails</li>
          <li>Natural age cracks in wood (stable)</li>
        </ul>
      </div>

      <div class="note-card bid-card">
        <div>
          <h3>Bidding Information</h3>
          <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
        </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->
</body>
</html>