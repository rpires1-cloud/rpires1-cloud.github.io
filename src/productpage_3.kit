<!-- @import "head" -->
<body>

  <!-- @import "header" -->

 <main>
  <section class="product-info">
    <div class="product-page-grid">
      <!-- LEFT -->
      <div>
        <figure class="product-page-image"><img src="src/assets/img/product_3/dressing-table-1.png" alt="Dressing Table view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_3/dressing-table-2.png" alt="Dressing Table view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_3/dressing-table-3.png" alt="GDressing Table view 2"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_3/dressing-table-4.png" alt="Dressing Table view 3"></figure>
            </div>
        </div>
      </div>

      <!-- RIGHT -->
      <div>
        <h1 class="product-title">Dressing Table</h1>
        <p class="product-subtitle">Art Nouveau</p>
        <p class="price">€4,800</p>
        <div class="details-box">
          <div class="product-detail-item">
            <!-- @import assets/svg/calendar-product.svg -->
            <div>
              <p class="detail-label">Auction Date</p>
              <p class="detail-value">30 May 2026</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/lot-number-product.svg -->
            <div>
              <p class="detail-label">Lot Number</p>
              <p class="detail-value">Lot 11</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/category-product.svg -->
            <div>
              <p class="detail-label">Category</p>
              <p class="detail-value">Furniture</p>
            </div>
          </div>

    </div>
  </section>

  <!-- CONTENT -->
  <section class="content-section container">
    <div class="content-grid">
    <!-- LEFT CONTENT -->
      <div>
        <div class="content-block">
          <h2>Description</h2>
          <p>A centerpiece of refinement, this 19th-century dressing table features harmonious
curved lines and an integrated oval mirror, exuding classic charm. With a rich wood finish and ornate details, this table is ideal for those seeking to combine historical functionality with a timeless luxury aesthetic.</p>
        </div>

        <div class="content-block">
          <h2>History & Provenance</h2>
          <h3>Historical Context</h3>
          <p>Typical of mid-19th-century cabinetmaking, this dressing table was an essential fixture in the boudoir of elite households. It served not only a functional purpose but also as a demonstration of the owner's status and taste for ornate, craftsmanship-heavy furniture.</p>
          <h3>Provenance</h3>
          <p>Estate of a French aristocratic family, 1860-1930;<br>Auctioned in Lyon, 1955;<br>Antique collection, Brussels, 1970-2005;<br>Acquired by current owner, 2010.</p>
        </div>
      </div>

      <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 155 cm</p>
            <p>Width: 110 cm</p>
            <p>Depth: 45 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Fine wood</p>
            <p>Mirror glass</p>
          </div>
          
          <div class="spec-group">
            <h4>Period</h4>
            <p>19th Century</p>
          </div>
        </aside>
      </div>
  </section>

      <!-- NOTES -->
  <section>
    <div class="notes-grid">
      <div class="note-card">
        <h3>Condition Notes</h3>
        <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and techniques.</p>
        <ul class="notes-list">
          <li>Minor losses to carved details on rear legs</li>
          <li>Historic repair to arm joint (stable and well-executed)</li>
          <li>Some darkening of wood finish on seat rails</li>
          <li>Natural age cracks in wood (stable)</li>
        </ul>
      </div>

      <div class="note-card bid-card">
        <div>
          <h3>Bidding Information</h3>
          <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
        </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->
</body>
</html>