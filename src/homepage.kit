<!-- @import "head" -->
<body>

<!-- @import "header" -->

<main>
<section class="banner">
    <figure class="hero-banner">
        <img src="src/assets/img/hero.png" alt="Interior Clássico Héritage" class="hero-img">
    </figure>
    <div class="hero-title">
        <h1>Curated <span class="page-title">Excellence</span></h1>
    </div>
</section>

<!-- @import "featured" -->

  <section class="mission-section">
    <div class="mission-container">
        <h2 class="mission-title">Where History Meets Elegance</h2>
        <div class="mission-text">
            <p>Since 1982, Héritage has been a sanctuary for the world's finest antiques and decorative arts. We believe that true luxury lies not in the new, but in the enduring beauty of objects that have witnessed history unfold.</p>
            
            <p>Our curators travel across Europe and beyond, meticulously selecting pieces that embody exceptional craftsmanship, provenance, and artistic merit. From Baroque grandeur to Art Nouveau fluidity, each acquisition represents a chapter in the ongoing narrative of human creativity.</p>
            
            <p>We don't just sell antiques — we preserve legacies, honor artisans, and connect collectors with objects that will define their own heritage for generations to come.</p>
        </div>
    </div>
  </section>

<!-- @import "upcoming-auctions" -->

  <section class="styles-gallery">
    <div class="container">
        <header class="section-header">
            <h2>Art by Style</h2>
            <p>Explore different artistic movements</p>
        </header>

        <div class="gallery-grid">
            <figure class="gallery-item baroque">
                <img src="src/assets/img/baroque.png" alt="Baroque style furniture and decor details">
                <figcaption class="style-label">Baroque</figcaption>
            </figure>

            <figure class="gallery-item modernism">
                <img src="src/assets/img/modernism.png" alt="Modernism art piece">
                <figcaption class="style-label">Modernism</figcaption>
            </figure>

            <figure class="gallery-item renaissance">
                <img src="src/assets/img/renaissance.png" alt="Renaissance classical painting">
                <figcaption class="style-label">Renaissance</figcaption>
            </figure>

            <figure class="gallery-item sacred">
                <img src="src/assets/img/sacred-art.png" alt="Sacred Art historical object">
                <figcaption class="style-label">Sacred Art</figcaption>
            </figure>

            <figure class="gallery-item nouveau">
                <img src="src/assets/img/art-nouveau.png" alt="Art Nouveau organic lines detail">
                <figcaption class="style-label">Art Nouveau</figcaption>
            </figure>

            <figure class="gallery-item neoclassical">
                <img src="src/assets/img/neoclassical.png" alt="Neoclassical symmetric architecture or object">
                <figcaption class="style-label">Neoclassical</figcaption>
            </figure>

            <figure class="gallery-item abstract">
                <img src="src/assets/img/abstract.png" alt="Abstract painting canvas">
                <figcaption class="style-label">Abstract</figcaption>
            </figure>

            <figure class="gallery-item deco">
                <img src="src/assets/img/art-deco.png" alt="Art Deco geometric pattern object">
                <figcaption class="style-label">Art Deco</figcaption>
            </figure>

            <figure class="gallery-item rococo">
                <img src="src/assets/img/rococo.png" alt="Rococo exuberant ornamentation detail">
                <figcaption class="style-label">Rococo</figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- @import "categories" -->
</main>

<!-- @import "footer" -->

</body>
</html>