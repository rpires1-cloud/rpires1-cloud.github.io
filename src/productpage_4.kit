<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Héritage | Classical Portrait</title>
    <link rel="stylesheet" href="/assets/css/style.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300&family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
  </head>
<body>

  <!-- @import "header" -->

 <main>
  <section class="product-page-info">
    <div class="product-page-grid">
      <!-- LEFT -->
      <div>
        <figure class="product-page-image"><img src="src/assets/img/product_4/portrait-2.png" id="selected" alt="Classic Protrait view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_4/portrait-2.png" class="product active" alt="Classic Protrait view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_4/portrait-3.png" class="product" alt="Classic Protrait view 2"></figure>
            </div>

        </div>
      </div>

      <!-- RIGHT -->
      <div>
        <h1 class="product-title">Classical Portrait</h1>
        <p class="product-subtitle">Italian Baroque</p>
        <p class="price">€5,900</p>
        <div class="details-box">
          <div class="product-detail-item">
            <!-- @import assets/svg/calendar-product.svg -->
            <div>
              <p class="detail-label">Auction Date</p>
              <p class="detail-value">15 July 2026</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/lot-number-product.svg -->
            <div>
              <p class="detail-label">Lot Number</p>
              <p class="detail-value">Lot 17</p>
            </div>
          </div>

          <div class="product-detail-item">
            <!-- @import assets/svg/category-product.svg -->
            <div>
              <p class="detail-label">Category</p>
              <p class="detail-value">Paitings</p>
            </div>
          </div>
    </div>
  </section>

  <!-- CONTENT -->
  <section class="content-section container">
    <div class="content-grid">
    <!-- LEFT CONTENT -->
      <div>
        <div class="content-block">
          <h2>Description</h2>
          <p>This 18th-century classical portrait captures the solemnity and striking presence of
a historical figure. The masterful execution, utilizing light and shadow (chiaroscuro) and set within an ornate gilded frame, lends the work an aura of prestige and authority, making it an essential piece for any period art collection.</p>
        </div>

        <div class="content-block">
          <h2>History & Provenance</h2>
          <h3>Historical Context</h3>
          <p>Painted by an anonymous master, this portrait follows the tradition of formal portraiture intended to convey the intellectual and social standing of the sitter. It exemplifies the 18th-century appreciation for realism, dignity, and the use of chiaroscuro to add psychological depth to the subject.</p>
          <h3>Provenance</h3>
          <p>Commissioned by the sitter’s family, 1780; <br> Passed down through family estate in England, 1780-1910;<br> Gallery acquisition, London, 1940;<br> Private collection, Edinburgh, 1965-present.</p>
        </div>
      </div>

      <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 90 cm</p>
            <p>Width: 75 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Oil on canvas</p>
            <p>Gilded wood</p>
          </div>
          
          <div class="spec-group">
            <h4>Period</h4>
            <p>18th Century</p>
          </div>
        </aside>
      </div>
  </section>

      <!-- NOTES -->
  <section>
    <div class="notes-grid">
      <div class="note-card">
        <h3>Condition Notes</h3>
        <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and techniques.</p>
        <ul class="notes-list">
          <li>Minor losses to carved details on rear legs</li>
          <li>Historic repair to arm joint (stable and well-executed)</li>
          <li>Some darkening of wood finish on seat rails</li>
          <li>Natural age cracks in wood (stable)</li>
        </ul>
      </div>

      <div class="note-card bid-card">
        <div>
          <h3>Bidding Information</h3>
          <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
        </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
      </div>
    </div>
  </section>
</main>
  
  <!-- @import "footer" -->
  <script src="src/assets/js/script.js"></script>

</body>
</html>