<!DOCTYPE html>
<html>

<head>
  <meta charset="utf-8">
  <title>Héritage | Georgian Armchair</title>
  <link rel="stylesheet" href="/assets/css/style.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300&family=Playfair+Display:ital,wght@1,400&display=swap"
    rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap" rel="stylesheet">
</head>

<body>

  <!-- @import "header" -->

  <main>
    <section class="product-page-info">
      <div class="product-page-grid">
        <!-- LEFT -->
        <div>
          <figure class="product-page-image"><img src="src/assets/img/product_1/armchair-2.png" id="selected"
              alt="Georgian armchair view 1"></figure>

          <div class="thumbnail-grid">
            <div class="thumbnail">
              <figure><img src="src/assets/img/product_1/armchair-2.png" class="product active"
                  alt="Georgian armchair view 1"></figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_1/armchair-3.png" class="product" alt="Georgian armchair view 2">
              </figure>
            </div>

            <div class="thumbnail">
              <figure><img src="src/assets/img/product_1/armchair-4.png" class="product" alt="Georgian armchair view 3">
              </figure>
            </div>
          </div>
        </div>

        <!-- RIGHT -->
        <div>
          <h1 class="product-title">Georgian Armchair</h1>
          <p class="product-subtitle">Italian Baroque</p>
          <p class="price">€3,200</p>
          <div class="details-box">
            <div class="product-detail-item">
              <!-- @import assets/svg/calendar-product.svg -->
              <div>
                <p class="detail-label">Auction Date</p>
                <p class="detail-value">15 May 2026</p>
              </div>
            </div>

            <div class="product-detail-item">
              <!-- @import assets/svg/lot-number-product.svg -->
              <div>
                <p class="detail-label">Lot Number</p>
                <p class="detail-value">Lot 17</p>
              </div>
            </div>

            <div class="product-detail-item">
              <!-- @import assets/svg/category-product.svg -->
              <div>
                <p class="detail-label">Category</p>
                <p class="detail-value">Furniture</p>
              </div>
            </div>

          </div>
          <p class="product-description">Majestic armchair with rich upholstery and sculptural wooden details.</p>
        </div>
      </div>
    </section>

    <!-- CONTENT -->
    <section class="content-section container">
      <div class="content-grid">
        <!-- LEFT CONTENT -->
        <div>
          <div class="content-block">
            <h2>Description</h2>
            <p>This commanding Italian Baroque armchair showcases the period's sculptural approach to furniture design.
              The walnut frame features deeply carved acanthus leaves, scrolling arms terminating in volutes, and
              cabriole legs with ball-and-claw feet.</p>
            <p>The chair has been reupholstered in period-appropriate Genoese velvet in deep crimson, complementing the
              rich patina of the carved wood. The overall effect is one of power and prestige.</p>
          </div>

          <div class="content-block">
            <h2>History & Provenance</h2>
            <h3>Historical Context</h3>
            <p>Originally created for a Roman palazzo circa 1680–1700, this armchair would have been part of a suite of
              seat furniture for the main reception room.</p>
            <p>The quality of carving suggests a major workshop, possibly connected to papal commissions. The chair
              represents the height of Italian Baroque furniture making.</p>
            <h3>Provenance</h3>
            <p>Roman workshop, circa 1690; Italian noble family, Rome, 1690–1850; Acquired by English collector on Grand
              Tour, 1850; English country house collection, 1850–1975; Professional reupholstery, 2005; Private
              collection, London, 1975–present.</p>
          </div>
        </div>

        <!-- SPECIFICATIONS -->
        <aside class="specifications">
          <h3>Specifications</h3>
          <div class="spec-group">
            <h4>Dimensions</h4>
            <p>Height: 128 cm</p>
            <p>Width: 72 cm</p>
            <p>Depth: 68 cm</p>
          </div>
          <div class="spec-group">
            <h4>Materials</h4>
            <p>Walnut</p>
            <p>Genoese velvet</p>
            <p>Gilt accents</p>
          </div>

          <div class="spec-group">
            <h4>Period</h4>
            <p>Italian Baroque</p>
          </div>
        </aside>
      </div>
    </section>

    <!-- NOTES -->
    <section>
      <div class="notes-grid">
        <div class="note-card">
          <h3>Condition Notes</h3>
          <p>Excellent structural condition. Professionally reupholstered in 2005 using period-appropriate materials and
            techniques.</p>
          <ul class="notes-list">
            <li>Minor losses to carved details on rear legs</li>
            <li>Historic repair to arm joint (stable and well-executed)</li>
            <li>Some darkening of wood finish on seat rails</li>
            <li>Natural age cracks in wood (stable)</li>
          </ul>
        </div>

        <div class="note-card bid-card">
          <div>
            <h3>Bidding Information</h3>
            <p>Interested in this piece? Register for our upcoming auction to place your bid.</p>
          </div>
          <a href="/auctions.html" class="btn">View Auction Details</a>
        </div>
      </div>
    </section>
  </main>
  <div id="product-modal" class="modal" aria-hidden="true">
    <span class="modal-close" title="Close image">&times;</span>
    <div class="modal-wrapper">
      <img class="modal-content" id="modal-img" src="" alt="">
    </div>
  </div>
  <!-- @import "footer" -->
  <script src="src/assets/js/script.js"></script>
</body>

</html>